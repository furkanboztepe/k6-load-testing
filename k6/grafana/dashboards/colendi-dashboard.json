{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Colendi Özel Yük Testi Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "📊 Genel Metrikler (Seçili Senaryo: $Senaryo)",
      "type": "row"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 800 } ] }, "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "title": "Aktif VU Sayısı",
      "type": "stat",
      "targets": [ { "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" }, "query": "from(bucket: \"k6\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"vus\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> filter(fn: (r) => r[\"testName\"] =~ /^${Senaryo:regex}$/)\n  |> group()\n  |> last()\n  |> yield(name: \"last\")", "refId": "A" } ]
    },
    {
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.99 } ] }, "unit": "percentunit" } },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 6,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "title": "✅ Başarı Oranı",
      "type": "stat",
      "targets": [ { "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" }, "query": "from(bucket: \"k6\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"http_reqs\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> filter(fn: (r) => r[\"testName\"] =~ /^${Senaryo:regex}$/)\n  |> group()\n  |> map(fn: (r) => ({ r with success_count: if r[\"status\"] == \"200\" and r[\"expected_response\"] != \"false\" then float(v: r._value) else 0.0 }))\n  |> reduce(fn: (r, accumulator) => ({ total: accumulator.total + float(v: r._value), successes: accumulator.successes + r.success_count }), identity: {total: 0.0, successes: 0.0})\n  |> map(fn: (r) => ({ _value: if r.total > 0.0 then r.successes / r.total else 0.0 }))\n  |> yield(name: \"last\")", "refId": "A" } ]
    },
    {
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background", "graphMode": "none" },
      "title": "Toplam İstek",
      "type": "stat",
      "targets": [ { "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" }, "query": "from(bucket: \"k6\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"http_reqs\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> filter(fn: (r) => r[\"testName\"] =~ /^${Senaryo:regex}$/)\n  |> group()\n  |> sum()\n  |> yield(name: \"sum\")", "refId": "A" } ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "📈 Zaman Serisi Grafikler",
      "type": "row"
    },
    {
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Response Time Dağılımı",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" }, "query": "from(bucket: \"k6\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"http_req_duration\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> filter(fn: (r) => r[\"testName\"] =~ /^${Senaryo:regex}$/)\n  |> group(columns: [\"_measurement\", \"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"Ortalama Süre\")", "refId": "A" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "🔴 VU Hata Logları (Loki)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 15 },
      "id": 20,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": true, "showLabels": true, "showTime": true, "sortOrder": "Descending" },
      "title": "VU Hata Logları",
      "type": "logs",
      "targets": [ { "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "expr": "{job=\"k6\"} |= \"request_failed\" |~ \"${Senaryo:regex}\" | json | line_format \"{{.msg}}\" | json | __error__=\"\"", "queryType": "range", "refId": "A" } ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["k6", "colendi"],
  "templating": {
    "list": [
      { "current": {}, "hide": 0, "includeAll": false, "name": "DS_INFLUXDB", "query": "influxdb", "type": "datasource" },
      { "current": {}, "hide": 0, "includeAll": false, "name": "DS_LOKI", "query": "loki", "type": "datasource" },
      {
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "Senaryo",
        "query": "import \"influxdata/influxdb/schema\"\nschema.measurementTagValues(bucket: \"k6\", measurement: \"http_reqs\", tag: \"testName\")",
        "regex": "/colendi/i",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "COLENDI - Yük Testleri",
  "uid": "colendi-loadtest",
  "version": 3
}